generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

model Job {
  id        String    @id @default(cuid())
  company   String
  role      String
  location  String?
  salary    String?
  status    JobStatus @default(SAVED)
  type      JobType   @default(FULL_TIME)
  appliedAt DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([company])
  @@index([createdAt])
}
